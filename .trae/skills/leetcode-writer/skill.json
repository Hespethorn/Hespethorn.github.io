{
  "name": "leetcode-writer",
  "version": "1.0.0",
  "description": "生成符合规范的LeetCode题解文章，遵循统一的文件命名、Front-matter和章节结构要求",
  "author": "Trae AI",
  "tags": ["leetcode", "algorithm", "problem-solving", "technical-writing", "python", "cpp"],
  "domains": ["algorithms", "python", "cpp"],
  "compatibility": ["trae-agent"],
  "license": "MIT",
  "repository": "https://github.com/example/leetcode-writer",
  "documentation": "SKILL.md",
  "inputs": {
    "language": {
      "type": "string",
      "required": true,
      "description": "编程语言：python 或 cpp",
      "enum": ["python", "cpp"]
    },
    "problem_number": {
      "type": "integer",
      "required": true,
      "description": "LeetCode 题目编号"
    },
    "problem_name": {
      "type": "string",
      "required": true,
      "description": "题目英文名称"
    },
    "output_path": {
      "type": "string",
      "required": false,
      "description": "输出目录路径",
      "default": "source/_posts/Leetcode/"
    }
  },
  "outputs": {
    "file_path": {
      "type": "string",
      "description": "生成的 Markdown 文件路径"
    },
    "problem_number": {
      "type": "integer",
      "description": "题目编号"
    },
    "problem_name": {
      "type": "string",
      "description": "题目名称"
    }
  }
}
