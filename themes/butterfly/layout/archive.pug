extends includes/layout.pug

block content
  #archive
    .archive-header
      .archive-title= `归档 · 共 ${getArchiveLength()} 篇文章`
    .archive-grid
      - let year
      - site.posts.forEach(article => {
        - const tempYear = date(article.date, 'YYYY')
        - const title = article.title || _p('no_title')
        if tempYear !== year
          - year = tempYear
          .archive-year= year
        .archive-card
          a.archive-card-link(href=url_for(article.path) title=title)
            if article.cover && theme.cover.archives_enable
              .archive-card-cover
                if article.cover_type === 'img'
                  img(src=url_for(article.cover) alt=title onerror=`this.onerror=null;this.src='${url_for(theme.error_img.post_page)}'`)
                else
                  div(style=`background: ${article.cover}`)
            .archive-card-info
              .archive-card-date
                i.far.fa-calendar-alt
                time(datetime=date_xml(article.date))= date(article.date, config.date_format)
              .archive-card-title= title
      - })