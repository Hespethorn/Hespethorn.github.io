- const hspCats = site.categories.data
- const hspPosts = site.posts.sort('date', -1).data
- const hspCat = name => hspCats.find(c => c.name === name)
- const hspCount = names => names.reduce((total, name) => { const c = hspCat(name); return total + (c ? c.length : 0) }, 0)
- const hspHas = (post, names) => post.categories.data.some(c => names.includes(c.name))
- const hspLatest = names => hspPosts.find(post => hspHas(post, names))
- const csCount = hspCount(['CS-Fundamentals', 'CS-Principles'])
- const csBase = hspCount(['CS-Fundamentals'])
- const csLatest = hspLatest(['CS-Fundamentals', 'CS-Principles'])
- const algoCount = hspCount(['Algorithms'])
- const algoLatest = hspLatest(['Algorithms'])
- const systemsCount = hspCount(['Systems'])
- const systemsLatest = hspLatest(['Systems'])
- const aiCount = hspCount(['AI-News'])
- const aiLatest = hspLatest(['AI-News'])
- const csMeter = Math.min(100, Math.round(csBase / 101 * 100))

.home-line-grid
  article.home-line-card
    .home-line-top
      span.no 01 / CS
      span.count= csCount + ' 篇'
    h3
      a(href='/categories/CS-Fundamentals/') CS 学习线
    p.desc CS50 / 61A / 61B / CSAPP / OS，一条按课程推进的基础路线，外加每周五一章的原则课。
    if csLatest
      .home-line-latest
        span.k LATEST
        a(href=url_for(csLatest.path))= csLatest.title
    .home-meter
      span(style='width:' + csMeter + '%')
    .home-meter-label
      span= '基础课 ' + csBase + ' / 101'
      span= '原则章 ' + hspCount(['CS-Principles']) + ' 篇'

  article.home-line-card
    .home-line-top
      span.no 02 / ALGORITHMS
      span.count= algoCount + ' 篇'
    h3
      a(href='/categories/Algorithms/') 算法与数据结构
    p.desc LeetCode、C++ DSA、经典算法练习册：从 B+ 树到 GBFS 搜索，从双指针到动态规划。
    if algoLatest
      .home-line-latest
        span.k LATEST
        a(href=url_for(algoLatest.path))= algoLatest.title
    .home-meter.is-muted
      span(style='width:100%')
    .home-meter-label
      span 持续练习
      span= algoCount + ' 篇'

  article.home-line-card
    .home-line-top
      span.no 03 / SYSTEMS
      span.count= systemsCount + ' 篇'
    h3
      a(href='/categories/Systems/') 系统与工程
    p.desc 祛魅式工程写作：真实权衡、检索 / 并发 / 缓存踩坑，以及那些只有上线才会发现的事。
    if systemsLatest
      .home-line-latest
        span.k LATEST
        a(href=url_for(systemsLatest.path))= systemsLatest.title
    .home-meter.is-muted
      span(style='width:100%')
    .home-meter-label
      span 持续沉淀
      span= systemsCount + ' 篇'

  article.home-line-card
    .home-line-top
      span.no 04 / AI
      span.count= aiCount + ' 期'
    h3
      a(href='/categories/AI-ML/AI-News/') AI 周报
    p.desc 每周日精选 AI 要闻：模型、开源、Agent、算力与政策。保持敏感，不追热闹。
    if aiLatest
      .home-line-latest
        span.k LATEST
        a(href=url_for(aiLatest.path))= aiLatest.title
    .home-meter.is-muted
      span(style='width:100%')
    .home-meter-label
      span 每周日更新
      span AI-News
