- const hspLatestPosts = site.posts.sort('date', -1).data

section#latest.home-section
  .home-section-head
    div
      span.eyebrow RECENT
      h2 最近更新
      p= '从 ' + site.posts.length + ' 篇里挑出最近的 6 篇，摘要只留一句。'
    a.arrow-link.home-arrow(href='/archives/')
      | 查看归档
      span.long-arrow

  .home-latest-card
    .home-latest-head
      div
        h2 时间流
        p 按发布日期倒序
      span.eyebrow ALL POSTS

    each post in hspLatestPosts.slice(0, 6)
      - const hspSeries = post.series ? (Array.isArray(post.series) ? post.series[0] : post.series) : (post.categories.data[0] ? post.categories.data[0].name : '未分类')
      a.home-post-row(href=url_for(post.path))
        .home-post-date
          = date(post.date, 'YYYY-MM-DD')
          span.series= hspSeries
        .home-post-main
          h3= post.title
          .home-post-desc!= postDesc(post)
        span.home-post-arrow ↗
