- const tagData = site.tags.data
- const tagOf = name => tagData.find(t => t.name === name)
- const tagRows = names => names.map(name => tagOf(name)).filter(Boolean)
-
  const tagGroups = [
    { label: '系统与网络', en: 'SYSTEMS', tags: ['Linux', 'Drogon', 'Computer-Networking', 'Redis', 'TCP', '分布式', '性能优化', '缓存'] },
    { label: '语言与工具', en: 'LANGUAGES', tags: ['C++', 'Python', 'Java', 'C语言', 'Git', 'SQL', 'CMake', 'Shell'] },
    { label: 'AI 与模型', en: 'AI / ML', tags: ['深度学习', '具身智能', 'AI编程', 'AI-News', 'Transformer', 'RAG', 'Agent', '多模态'] },
    { label: '算法与数据', en: 'ALGORITHMS', tags: ['leetcode', 'tree', '数据结构', '双指针', '动态规划', '图论', '二分', '哈希'] },
    { label: '写作与方法', en: 'METHOD', tags: ['CS-Principles', '专栏介绍', '学习方法', '工程实践', '复盘', '读书笔记', '时间管理', '写作'] }
  ]
- const sortedTags = tagData.slice().sort((a, b) => b.length - a.length)
- const topTags = sortedTags.slice(0, 32)
- const singletonCount = tagData.filter(t => t.length === 1).length

#tags-index
  .map-wrap
    .map-lead
      span.eyebrow INDEX / TAGS
      p 标签是跨分类的主题索引。找系列请走“主线”；找具体技术点，从这里进。

    .tag-search
      svg(width='17' height='17' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6')
        circle(cx='11' cy='11' r='7')
        path(d='m20 20-3.5-3.5')
      input(type='text' placeholder='搜索标签，如：缓存 / Raft / 性能')
      span.hint= site.tags.length

    section.tag-groups
      each group in tagGroups
        - const rows = tagRows(group.tags)
        if rows.length
          .tag-group
            h3
              = group.label
              span= group.en
            each tag in rows
              a.tag-row(href=url_for(tag.path))
                span= tag.name
                b= tag.length

    section.all-tags
      .all-tags-head
        div
          h2
            | 全部标签
            span.total= site.tags.length
          p
            b= singletonCount + ' 个只出现一次'
            | ——它们已折叠到“更多”，不再铺满页面。
        span.sort 按使用次数 ↓

      .tag-list
        each tag in topTags
          a.tag-row(href=url_for(tag.path))
            span= tag.name
            b= tag.length

      .tag-list.all-tags-more(style='display:none')
        each tag in sortedTags.slice(32)
          a.tag-row(href=url_for(tag.path))
            span= tag.name
            b= tag.length

      .all-tags-foot
        span= '还有 ' + (site.tags.length - 32) + ' 个标签，按使用次数展开。'
        a.ghost-btn#toggle-all-tags(href='javascript:void(0)')
          span 展开全部标签
          span ↗

    section.tag-note
      div
        span.label TAG POLICY
        h2 标签约定
      ol
        li
          b 系列用分类，不用标签。
          | 找 CS-Principles、Seckill、CS61A，请从“主线”或“分类”进。
        li
          b 同义标签已合并。
          | Python / python、C++ / cpp 只保留一个；大小写统一。
        li
          b 一次性标签折叠。
          | 只出现一次的 #{singletonCount} 个标签收进“更多”，不再铺满页面。

  script.
    (() => {
      const input = document.querySelector('.tag-search input');
      const more = document.querySelector('.all-tags-more');
      const toggle = document.getElementById('toggle-all-tags');
      if (!input) return;
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        document.querySelectorAll('#tags-index .tag-row').forEach(row => {
          row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
      });
      if (toggle && more) {
        toggle.addEventListener('click', event => {
          event.preventDefault();
          const opening = more.style.display === 'none';
          more.style.display = opening ? '' : 'none';
          toggle.querySelector('span').textContent = opening ? '收起全部标签' : '展开全部标签';
        });
      }
    })();
