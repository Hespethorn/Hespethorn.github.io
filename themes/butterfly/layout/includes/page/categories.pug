- const mapCats = site.categories.data
- const mapCat = name => mapCats.find(c => c.name === name)
- const mapCount = names => names.reduce((total, name) => { const c = mapCat(name); return total + (c ? c.length : 0) }, 0)

#categories-map
  .map-wrap
    .map-lead
      span.eyebrow MAP / 2026
      p= site.posts.length + ' 篇文章，按“主线 / 方向 / 存档”重新排过。先看主线，再按方向找；练习册和旧系列收在最后。'

    section.composition
      div
        h2 内容构成
        p 按顶层分类统计，不按文章数量排名。
      div
        .comp-bar
          span.c-main(style='width:' + Math.round(mapCount(['CS-Fundamentals', 'CS-Principles', 'Algorithms', 'Systems', 'AI-News']) / site.posts.length * 100) + '%')
          span.c-dir(style='width:' + Math.round(mapCount(['Networking', 'Database', 'Frontend', 'Source-Reading', 'Life', 'AI-App']) / site.posts.length * 100) + '%')
          span.c-arch(style='width:' + Math.round(mapCount(['Seckill', 'Languages', 'Fables']) / site.posts.length * 100) + '%')
        .comp-legend
          span
            i.m
            = '主线 ' + mapCount(['CS-Fundamentals', 'CS-Principles', 'Algorithms', 'Systems', 'AI-News']) + ' 篇 · ' + Math.round(mapCount(['CS-Fundamentals', 'CS-Principles', 'Algorithms', 'Systems', 'AI-News']) / site.posts.length * 100) + '%'
          span
            i.d
            = '方向 ' + mapCount(['Networking', 'Database', 'Frontend', 'Source-Reading', 'Life', 'AI-App']) + ' 篇 · ' + Math.round(mapCount(['Networking', 'Database', 'Frontend', 'Source-Reading', 'Life', 'AI-App']) / site.posts.length * 100) + '%'
          span
            i.a
            = '存档 ' + mapCount(['Algorithms', 'Languages', 'Fables']) + ' 篇 · ' + Math.round(mapCount(['Algorithms', 'Languages', 'Fables']) / site.posts.length * 100) + '%'

    section.map-section
      .section-head
        div
          span.eyebrow THE SPINE
          h2 四条主线
          p 先读这里。其他内容都可以从这里长出来。
        a.arrow-link.light(href='/')
          | 回首页
          span.long-arrow
      include ../home/line-cards.pug

    section.map-section
      .section-head
        div
          span.eyebrow DIRECTIONS
          h2 按方向
          p 主线之外的常读方向；带“子方向”的，是主线下面的细分。
      .dirs
        a.dir-card(href='/categories/Networking/')
          .top
            span NETWORK
            span= mapCount(['Networking']) + ' 篇'
          h3 网络
          .count= mapCount(['Networking'])
          p.tags TCP · DNS · XFF · 路由
        a.dir-card(href='/categories/Database/')
          .top
            span DATABASE
            span= mapCount(['Database']) + ' 篇'
          h3 数据库
          .count= mapCount(['Database'])
          p.tags MySQL · Redis · MVCC · 索引
        a.dir-card(href='/categories/Frontend/')
          .top
            span FRONTEND
            span= mapCount(['Frontend']) + ' 篇'
          h3 前端
          .count= mapCount(['Frontend'])
          p.tags CSS · 布局 · 性能
        a.dir-card(href='/categories/Source-Reading/')
          .top
            span SOURCE
            span= mapCount(['Source-Reading']) + ' 篇'
          h3 源码阅读
          .count= mapCount(['Source-Reading'])
          p.tags Netty · 内核 · 框架
        a.dir-card(href='/categories/Systems/Linux/')
          .top
            span LINUX
            span.sub 子方向
          h3 Linux
          .count= mapCount(['Linux'])
          p.tags 多网卡 · 路由 · 权限
        a.dir-card(href='/categories/Systems/Dev-Practice/')
          .top
            span DEV-PRACTICE
            span.sub 子方向
          h3 工程实践
          .count= mapCount(['Dev-Practice'])
          p.tags 复盘 · 工具 · 协作
        a.dir-card(href='/categories/AI-ML/AI-App/')
          .top
            span AI-APP
            span.sub 子方向
          h3 AI 应用
          .count= mapCount(['AI-App'])
          p.tags Agent · RAG · 工具调用
        a.dir-card.life(href='/categories/Life/')
          .top
            span LIFE
            span= mapCount(['Life']) + ' 篇'
          h3 生活
          .count= mapCount(['Life'])
          p.tags 家书 · 随笔

    section.map-section
      .section-head
        div
          span.eyebrow ARCHIVE
          h2 存档
          p 最近在读与旧稿、练习册放在一起；存量保留，不再更新。
      .archive
        div
          span.label READING / ARCHIVE
          h2 最近在读 / 旧稿与练习
          .reading-now
            span.reading-kicker 正在读
            p.reading-title 大模型技术三十讲
          p 最近在读与旧稿、练习册放在一起。想找旧文，从右边进；想了解现在，回主线。
        .archive-rows
          a.archive-row(href='/categories/Seckill/')
            span.n= mapCount(['Seckill'])
            span.name
              | 秒杀系统实战
              small C++ · Drogon · RabbitMQ · 高并发
            span.go ↗
          a.archive-row(href='/categories/Languages/')
            span.n= mapCount(['Languages'])
            span.name
              | 编程语言手册
              small C / C++ · Python · Lua · 多语言对比
            span.go ↗
          a.archive-row(href='/categories/Fables/')
            span.n= mapCount(['Fables'])
            span.name
              | 寓言
              small 已停更 · 93 篇存量
            span.go ↗
