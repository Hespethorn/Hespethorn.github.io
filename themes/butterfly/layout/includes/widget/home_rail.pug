- const hspRailPosts = site.posts.sort('date', -1).data
- const hspNowPost = hspRailPosts.find(post => post.categories.data.some(c => c.name === 'CS-Principles'))

.home-rail
  !=partial('includes/widget/card_author', {}, {cache: true})

  article.card-widget.home-now
    span.eyebrow NOW
    h3 正在写
    if hspNowPost
      p.home-now-title= hspNowPost.title
      a.home-now-link(href=url_for(hspNowPost.path)) 读这一章
    else
      p.home-now-title 最近在整理原则章。
    .home-now-meter
      span(style='width:62%')
    .home-now-foot
      span 每周五更新
      span CS-Principles

  article.card-widget.home-letters
    img(src='/img/loading.gif' alt='')
    div
      span.eyebrow 家书
      h3 写给父亲，也写给她
      p 不放进时间流，单独收着。
      a(href='/posts/FamilyProse/') 父亲的与子书 ↗
      a(href='/posts/LoveDays/') 给女友的情书 ↗

  article.card-widget.home-index
    h3 索引
    .home-index-grid
      a(href='/archives/') 归档 2026 ↗
      a(href='/tags/') 标签索引 ↗
      a(href='/link/') 收藏夹 ↗
      a(href='/atom.xml') RSS ↗
