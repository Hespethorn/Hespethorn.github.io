if theme.aside.card_announcement.enable
  .card-widget.card-announcement
    .footer-other(style='display: flex; justify-content: center; align-items: center; gap: 20px;')
        img.footer-image(src=url_for('/img/fox.jpg') alt='fox' style='border-radius: 50%; transition: transform 0.3s ease; width: 50px; height: 50px;' onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'")
        .ecg-icon <i class="fa-solid fa-heart-pulse"></i>
        script.
          document.addEventListener('DOMContentLoaded', function() {
            const heartIcon = document.querySelector('.ecg-icon .fa-heart-pulse');
            let intervalId;

            // 初始设置为每秒 70 次跳动
            function setHeartRate(bpm) {
              const interval = 60000 / bpm;
              clearInterval(intervalId);
              heartIcon.style.animation = `pulse ${interval}ms infinite`;
              intervalId = setInterval(() => {
                heartIcon.classList.toggle('pulse');
              }, interval / 2);
            }

            // 初始心率 80 次/分钟
            setHeartRate(80);

            // 鼠标移入事件，设置为 100 次/分钟
            heartIcon.parentElement.addEventListener('mouseover', function() {
              setHeartRate(100);
            });

            // 鼠标移出事件，恢复为 70 次/分钟
            heartIcon.parentElement.addEventListener('mouseout', function() {
              setHeartRate(80);
            });
          });
          // 添加关键帧动画
          const style = document.createElement('style');
          style.textContent = `
            @keyframes pulse {
              0% { transform: scale(1.5); }
              50% { transform: scale(1.8); }
              100% { transform: scale(1.5); }
            }
            .fa-heart-pulse {
              color: red; /* 设置心图标为红色 */
            }
            .fa-heart-pulse.pulse {
              animation: pulse;
            }
          `;
          document.head.appendChild(style);
        img.footer-image(src=url_for('/img/ciwei.jpg') alt='ciwei' style='border-radius: 50%; transition: transform 0.3s ease; width: 50px; height: 50px;' onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'")
    // 确保显示相爱时间元素
    .footer-other(style='display: flex; justify-content: center; align-items: center; gap: 15px;')
        #love-time(style='text-align: center;')
        script.
          // 初始日期
          const startDate = new Date('2021-08-08T00:00:00');
          const loveTimeElement = document.getElementById('love-time');

          function updateLoveTime() {
            const now = new Date();
            const diff = now - startDate;

            const seconds = Math.floor(diff / 1000) % 60;
            const minutes = Math.floor(diff / (1000 * 60)) % 60;
            const hours = Math.floor(diff / (1000 * 60 * 60)) % 24;
            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            // 使用 innerHTML 结合 <br> 实现换行
            loveTimeElement.innerHTML = `情丝初系，相思始长<br>${days} 天 ${hours} 时 ${minutes} 分 ${seconds} 秒`;
          }

          // 初始调用
          updateLoveTime();
          // 每秒更新一次
          setInterval(updateLoveTime, 1000);